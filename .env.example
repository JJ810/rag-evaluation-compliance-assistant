# Local-first defaults. Copy to .env only if you want to override settings locally.
ENVIRONMENT=local

# Providers: mock is deterministic and free. openai requires OPENAI_API_KEY.
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock

# Optional OpenAI configuration. Do not commit real keys.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Retrieval configuration.
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.18

# API configuration.
API_HOST=0.0.0.0
API_PORT=8000
